DATABASE_URL=postgresql+psycopg://workloop_file_scanner:replace-with-local-secret@postgres:5432/workloop
STORAGE_BACKEND=synthetic
STORAGE_SIGNING_KEY=replace-with-32-random-bytes-as-unpadded-base64url
ATTACHMENT_OBJECT_KEY_HMAC_KEY=replace-with-another-32-random-bytes-as-unpadded-base64url
SYNTHETIC_STORAGE_PATH=/var/lib/workloop-storage
MALWARE_SCANNER_BACKEND=synthetic
MALWARE_SCANNER_DEFINITION=synthetic-v1
MALWARE_SCANNER_SIGNING_KEY=replace-with-a-third-32-byte-key-as-unpadded-base64url
