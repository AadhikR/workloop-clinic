APP_ENV=local
APP_BASE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5174
LOG_LEVEL=INFO
DATABASE_HEALTH_TIMEOUT_SECONDS=5
API_REQUEST_TIMEOUT_SECONDS=15
APPLICATION_USER_LOOKUP_TIMEOUT_SECONDS=5
OIDC_ISSUER=http://127.0.0.1:8080/realms/workloop-dev
OIDC_AUDIENCE=workloop-api
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/workloop-dev/protocol/openid-connect/certs
OIDC_JWKS_CONNECT_TIMEOUT_SECONDS=2
OIDC_JWKS_READ_TIMEOUT_SECONDS=2
OIDC_JWKS_TOTAL_TIMEOUT_SECONDS=5
OIDC_JWKS_CACHE_TTL_SECONDS=300
OIDC_JWKS_REFRESH_COOLDOWN_SECONDS=1
TRUSTED_PROXY=direct
STORAGE_BACKEND=disabled
# Phase 6G cloud names only. Keep both key values outside source control.
# SPACES_ENDPOINT_URL=https://fra1.digitaloceanspaces.com
# SPACES_REGION=fra1
# SPACES_BUCKET=replace-with-private-space-name
# SPACES_ACCESS_KEY=replace-with-scoped-access-key
# SPACES_SECRET_KEY=replace-with-scoped-secret-key
DATABASE_URL=postgresql+psycopg://workloop_runtime:replace-with-local-secret@postgres:5432/workloop
CURSOR_SIGNING_KEY=replace-with-32-random-bytes-as-unpadded-base64url
