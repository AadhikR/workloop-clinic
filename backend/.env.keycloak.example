KC_DB_PASSWORD=replace-with-the-keycloak-database-secret
# Local Compose uses these values. Shared development injects them only for first-start bootstrap.
KC_BOOTSTRAP_ADMIN_USERNAME=workloop-local-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-local-administrator-secret
WORKLOOP_KEYCLOAK_ADMIN_USERNAME=replace-with-the-permanent-administrator-name
